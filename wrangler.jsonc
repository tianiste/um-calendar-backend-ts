{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "um-calendar-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-08",
  "workers_dev": true,
  "observability": {
    "enabled": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "um-calendar",
      "migrations_dir": "migrations"
    }
  ]
}
