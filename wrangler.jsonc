{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "um-calendar-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-08",
  "workers_dev": true,
  "observability": {
    "enabled": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "um-calendar",
      "migrations_dir": "migrations",
      "database_id": "cd5a6c0b-8c9e-400e-b1e1-5c21a0a48618"
    }
  ],
  "ratelimits": [
    {
      "name": "RATE_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 50,
        "period": 10
      }
    }
  ],
  "triggers": {
    "crons": [
      "17 * * * *",
      "* * * * *"
    ]
  }
}
